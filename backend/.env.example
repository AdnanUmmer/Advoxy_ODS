DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Set to 1 only for local SQLite development. Use 0 for PostgreSQL.
USE_SQLITE=0
POSTGRES_DB=advoxy
POSTGRES_USER=advoxy_app
POSTGRES_PASSWORD=replace-with-postgresql-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

REDIS_URL=redis://localhost:6379/0
CUSTOMER_WEB_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

STRIPE_SECRET_KEY=replace-with-stripe-secret
STRIPE_PUBLISHABLE_KEY=replace-with-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret
STRIPE_CONNECT_CLIENT_ID=replace-with-stripe-connect-client-id
DEMO_BOOKING_TOOLS_ENABLED=true

FIREBASE_CREDENTIALS_JSON=replace-with-path-to-firebase-credentials
CLOUDINARY_URL=replace-with-cloudinary-url
GOOGLE_MAPS_API_KEY=replace-with-google-maps-key
GOOGLE_MAPS_API_BASE_URL=https://maps.googleapis.com
GOOGLE_CLIENT_ID=replace-with-google-web-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GPS_ARRIVAL_THRESHOLD_METERS=150
TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_PHONE_NUMBER=replace-with-twilio-phone-number
SENDGRID_API_KEY=replace-with-sendgrid-api-key
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=notifications@example.com
VERIFICATION_PROVIDER=persona
PERSONA_API_KEY=replace-with-persona-api-key
PERSONA_TEMPLATE_ID=replace-with-persona-template-id
PERSONA_WEBHOOK_SECRET=replace-with-persona-webhook-secret
PERSONA_API_BASE_URL=https://api.withpersona.com/api/v1
CERTN_API_KEY=replace-with-certn-api-key
CERTN_WEBHOOK_SECRET=replace-with-certn-webhook-secret
CERTN_API_BASE_URL=https://api.certn.co/api/v1
